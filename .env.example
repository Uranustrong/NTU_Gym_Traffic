# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as the template.

# --- Postgres ---
POSTGRES_USER=songhejun
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gym_fetch
# Optional: full URL used by sync_to_postgres.py / rsync.sh / tools/sync_local.sh.
# If unset, it is auto-constructed from the three values above + host
# 127.0.0.1:5433. Password is URL-encoded automatically.
# POSTGRES_URL=postgresql://songhejun:changeme@127.0.0.1:5433/gym_fetch

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- Server-side / shared-host knobs (defaults are safe for local dev) ---

# Bind the postgres / grafana host ports to a specific address. Default
# `127.0.0.1` means the ports are only reachable from the host loopback —
# important on a multi-user workstation where other students share the box.
# Set to `0.0.0.0` only if you understand the security implications.
# PG_BIND_ADDR=127.0.0.1
# GRAFANA_BIND_ADDR=127.0.0.1

# Optional: enable Grafana's anonymous Viewer role (no login to view).
# NOT needed for the public page — that is generated by
# tools/render_public_html.py straight from Postgres and never touches
# Grafana. Leave this off unless you specifically want password-free
# Grafana access for yourself over an SSH tunnel.
# GRAFANA_AUTH_ANONYMOUS_ENABLED=true
