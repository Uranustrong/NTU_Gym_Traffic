# Template for supabase.secrets — copy, fill in, keep local.
#
#   cp supabase.secrets.example supabase.secrets
#   chmod 600 supabase.secrets
#   $EDITOR supabase.secrets
#
# supabase.secrets is gitignored (*.secrets). It is meant to be *sourced* by
# tooling, never read out and pasted anywhere:
#
#   bash -c 'set -a; . ./supabase.secrets; set +a; tools/apply_migrations.sh "$SUPABASE_OWNER_URL"'
#
# You only need to fill in the first three. The role passwords are generated
# for you in step 6 of docs/SUPABASE_SETUP.md.

# ---------------------------------------------------------------------------
# From the Supabase dashboard (see docs/SUPABASE_SETUP.md steps 1-4)
# ---------------------------------------------------------------------------

# The project ref: the alphanumeric id in your dashboard URL,
# https://supabase.com/dashboard/project/<THIS-PART>
SUPABASE_PROJECT_REF=

# The Session pooler host, e.g. aws-1-ap-northeast-1.pooler.supabase.com
# Connect -> Session pooler. Copy only the hostname, no port.
SUPABASE_POOLER_HOST=

# The database password you chose when creating the project. This is the
# password for the `postgres` owner role. Shown once at creation time.
PGPASSWORD=

# ---------------------------------------------------------------------------
# Derived — no need to edit
# ---------------------------------------------------------------------------

# Owner connection, used only for migrations, backfill and pg_dump. Note there
# is deliberately no port and no sslmode in the URL: libpq lets an explicit URL
# value override the environment, so hardcoding them here would make PGPORT and
# PGSSLMODE dead settings.
SUPABASE_OWNER_URL=postgresql://postgres.${SUPABASE_PROJECT_REF}@${SUPABASE_POOLER_HOST}/postgres

# Through Supavisor every role carries the project ref as a suffix, custom
# roles included — so gym_writer connects as gym_writer.<project-ref>.
SUPABASE_WRITER_URL=postgresql://gym_writer.${SUPABASE_PROJECT_REF}@${SUPABASE_POOLER_HOST}/postgres
SUPABASE_READER_URL=postgresql://gym_reader.${SUPABASE_PROJECT_REF}@${SUPABASE_POOLER_HOST}/postgres

PGPORT=5432
PGSSLMODE=require
PGCONNECT_TIMEOUT=15

# ---------------------------------------------------------------------------
# Generated in step 6 — leave blank for now
# ---------------------------------------------------------------------------
GYM_WRITER_PASSWORD=
GYM_READER_PASSWORD=
