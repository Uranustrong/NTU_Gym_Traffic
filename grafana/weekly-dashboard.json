{
  "dashboard": {
    "id": null,
    "uid": "gym-weekly-display",
    "title": "Gym Weekly Occupancy",
    "tags": [
      "gym",
      "weekly"
    ],
    "timezone": "browser",
    "schemaVersion": 42,
    "version": 0,
    "refresh": "5m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "venue",
          "type": "query",
          "label": "Venue",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfm1ctqr9jgn4b"
          },
          "query": "SELECT DISTINCT venue FROM occupancy ORDER BY venue;",
          "refresh": 1,
          "multi": false,
          "includeAll": false,
          "current": {
            "selected": false,
            "text": "健身中心",
            "value": "健身中心"
          }
        },
        {
          "name": "metric",
          "type": "custom",
          "label": "Metric",
          "query": "avg_count,crowding_ratio",
          "current": {
            "selected": true,
            "text": "avg_count",
            "value": "avg_count"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "table",
        "title": "Current vs Same Weekday/Time History",
        "gridPos": {
          "h": 7,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "bfm1ctqr9jgn4b"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "bfm1ctqr9jgn4b"
            },
            "format": "table",
            "rawQuery": true,
            "editorMode": "code",
            "rawSql": "SELECT\n  venue,\n  latest_fetched_at,\n  current_count,\n  historical_median_current_count,\n  difference_from_median,\n  sample_count,\n  current_crowding_ratio\nFROM current_vs_history\nORDER BY venue;"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "difference_from_median"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 10
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm"
        }
      },
      {
        "id": 2,
        "type": "table",
        "title": "Weekly 30-Minute Occupancy Heatmap",
        "gridPos": {
          "h": 18,
          "w": 24,
          "x": 0,
          "y": 7
        },
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "bfm1ctqr9jgn4b"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "bfm1ctqr9jgn4b"
            },
            "format": "table",
            "rawQuery": true,
            "editorMode": "code",
            "rawSql": "WITH metric_slots AS (\n  SELECT\n    weekday_number,\n    slot_start_time,\n    slot_label,\n    CASE\n      WHEN '${metric}' = 'crowding_ratio' THEN avg_crowding_ratio\n      ELSE avg_current_count\n    END AS value\n  FROM weekly_occupancy_slots\n  WHERE venue = ${venue:sqlstring}\n)\nSELECT\n  slot_label AS \"Time\",\n  MAX(value) FILTER (WHERE weekday_number = 1) AS \"Mon\",\n  MAX(value) FILTER (WHERE weekday_number = 2) AS \"Tue\",\n  MAX(value) FILTER (WHERE weekday_number = 3) AS \"Wed\",\n  MAX(value) FILTER (WHERE weekday_number = 4) AS \"Thu\",\n  MAX(value) FILTER (WHERE weekday_number = 5) AS \"Fri\",\n  MAX(value) FILTER (WHERE weekday_number = 6) AS \"Sat\",\n  MAX(value) FILTER (WHERE weekday_number = 7) AS \"Sun\"\nFROM metric_slots\nGROUP BY slot_start_time, slot_label\nORDER BY slot_start_time;"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "center",
              "cellOptions": {
                "type": "color-background"
              }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 40
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Time"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "auto"
                  }
                },
                {
                  "id": "custom.align",
                  "value": "left"
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": []
        }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Selected Venue Exact Counts",
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 25
        },
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "bfm1ctqr9jgn4b"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "bfm1ctqr9jgn4b"
            },
            "format": "time_series",
            "rawQuery": true,
            "editorMode": "code",
            "rawSql": "SELECT\n  fetched_at AS \"time\",\n  venue AS metric,\n  current_count AS value\nFROM occupancy\nWHERE $__timeFilter(fetched_at)\n  AND venue = ${venue:sqlstring}\nORDER BY fetched_at;"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never"
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      }
    ]
  },
  "overwrite": true
}
