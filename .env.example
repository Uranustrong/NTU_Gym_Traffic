# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as the template.

# --- Postgres ---
POSTGRES_USER=songhejun
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gym_fetch
# Optional: full URL used by sync_to_postgres.py / rsync.sh. If unset, it is
# auto-constructed from the three values above + host 127.0.0.1:5433.
# POSTGRES_URL=postgresql://songhejun:changeme@127.0.0.1:5433/gym_fetch

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
