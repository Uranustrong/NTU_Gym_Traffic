# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local data and exports
*.sqlite3
*.sqlite3.*
*.db
*.db-*
*.csv
# Narrow: only the recovery export is meant to be versioned. A blanket
# !docs/**/*.csv would quietly admit any future data dump left under docs/.
!docs/recovery/*.csv

# Runtime logs
logs/
*.log

# Local-only sync/config files
.env
.env.*
!.env.example

# Brainstorming scratch output
.superpowers/brainstorm/

# Local holding area for deleted files. Git already records the deletion, so
# versioning a second copy here is redundant. TRASH-FILES.md (the log of what
# went in and why) stays tracked.
TRASH/

# Credentials handed to local tooling by sourcing, never by reading.
# *.secrets.example templates stay tracked.
*.secrets

# OS/editor noise
.DS_Store
*.swp
*.swo

# Docker/Grafana local state should live in Docker volumes, not git
docker-data/
grafana-data/
postgres-data/
