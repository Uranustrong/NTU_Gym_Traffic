# Example crontab for the server-side (ws7) deployment.
# Install with:  crontab crontab.example
# Inspect with:  crontab -l
# Edit with:     crontab -e
#
# Adjust the ID in the paths to match your CSIE account. The paths assume
# the repo is at /tmp2/<id>/Gym_Fetch and the public HTML directory is at
# /home/<id>/public_html/gym.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=

# ---------------------------------------------------------------------------
# 1. Collector: fetch_counts.py every 5 minutes during sports-center open
#    hours. The script's own --open-hours-only flag double-checks, so the
#    cron windows can be slightly conservative.
# ---------------------------------------------------------------------------
*/5 6-21 * * 1-5 cd /tmp2/b12902066/Gym_Fetch && /usr/bin/python3 fetch_counts.py --open-hours-only >> logs/cron.log 2>&1
*/5 9-21 * * 6   cd /tmp2/b12902066/Gym_Fetch && /usr/bin/python3 fetch_counts.py --open-hours-only >> logs/cron.log 2>&1
*/5 9-17 * * 0   cd /tmp2/b12902066/Gym_Fetch && /usr/bin/python3 fetch_counts.py --open-hours-only >> logs/cron.log 2>&1

# ---------------------------------------------------------------------------
# 2. Sync sqlite -> postgres every 10 minutes (offset 2 min so it never
#    races with the collector). tools/sync_local.sh sources .env so the
#    postgres URL is not hard-coded here.
# ---------------------------------------------------------------------------
2-58/10 * * * * /tmp2/b12902066/Gym_Fetch/tools/sync_local.sh >> /tmp2/b12902066/Gym_Fetch/logs/sync.log 2>&1

# ---------------------------------------------------------------------------
# 3. Public page: regenerate the interactive static dashboard into
#    ~/public_html/gym/ every 5 minutes so nginx UserDir can serve it as:
#    https://www.csie.ntu.edu.tw/~b12902066/gym/
#    Pure stdlib + psql — no headless browser needed.
# ---------------------------------------------------------------------------
*/5 * * * * cd /tmp2/b12902066/Gym_Fetch && /usr/bin/python3 tools/render_public_html.py --output-dir /home/b12902066/public_html/gym --psql tools/psql_gym_postgres.sh >> logs/render.log 2>&1
